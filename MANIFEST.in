include .gitignore .gitattributes README.md LICENSE AGENTS.md requirements-verification.lock
recursive-include netcircuit_sim *.py
recursive-include tests *.py
recursive-include scripts *.py *.mjs
recursive-include integration *.json
recursive-include docs *.md
recursive-include migration *.md
recursive-include .github/workflows *.yml
global-exclude __pycache__ *.py[cod]
